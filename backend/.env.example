NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:password@localhost:5432/numbaa

REDIS_URL=redis://localhost:6379

JWT_SECRET=change_this_to_a_32_char_secret_key
JWT_EXPIRY=7d

VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=

# true = OTP affiché dans les logs serveur uniquement (pas envoyé via WhatsApp)
# false = envoi réel via Baileys (nécessite QR scan au démarrage)
BYPASS_WHATSAPP=true

MAX_FILE_SIZE=5242880
ALLOWED_ORIGINS=http://localhost:3000

# Logos et photos produit sont uploadés sur Vercel Blob (public).
# Store créé dans Storage → Create → Blob, puis connecté au projet "numbaa"
# (onglet Projects du store → Connect to Project). Une fois connecté, Vercel
# injecte automatiquement BLOB_STORE_ID + VERCEL_OIDC_TOKEN — aucune variable
# a ajouter ici en production (redéployer après connexion pour les prendre en
# compte). En local, `vercel link` puis `vercel env pull .env` les récupère.
# BLOB_READ_WRITE_TOKEN n'est nécessaire que si ce code tournait hors Vercel.
