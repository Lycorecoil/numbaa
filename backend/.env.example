NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:password@localhost:5432/numbaa

REDIS_URL=redis://localhost:6379

JWT_SECRET=change_this_to_a_32_char_secret_key
JWT_EXPIRY=7d

VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=

# true = OTP affiché dans les logs serveur uniquement (pas envoyé via WhatsApp)
# false = envoi réel via Baileys (nécessite QR scan au démarrage)
BYPASS_WHATSAPP=true

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_ORIGINS=http://localhost:3000
